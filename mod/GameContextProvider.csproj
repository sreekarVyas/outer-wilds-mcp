<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>GameContextProvider</AssemblyName>
    <RootNamespace>GameContextProvider</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Unity assemblies are not strong-name/deterministic friendly; keep it simple. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
  </ItemGroup>

  <!-- The game's own assemblies are added by AddGameReferences in Directory.Build.props,
       which has to resolve the install path first. See the ordering note there. -->

  <!-- Convenience: dotnet build -p:DeployToGame=true  drops the dll into BepInEx\plugins -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(OwGameDir)\BepInEx\plugins\GameContextProvider" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(OwGameDir)\BepInEx\plugins\GameContextProvider" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(OwGameDir)\BepInEx\plugins\GameContextProvider" />
  </Target>

</Project>
